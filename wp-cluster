}, 10, 2 );

// 2) 请求层：删除、启用、停用在真正执行前拦下。
//    核心 plugins.php 校验的是复数 delete_plugins，单数 delete_plugin 在
//    map_meta_cap 里没有分支，所以靠 map_meta_cap 拦不住，必须拦请求。
add_action( "load-plugins.php", function () {
    $action  = isset( $_REQUEST["action"] ) ? (string) $_REQUEST["action"] : "";
    $checked = isset( $_REQUEST["checked"] ) ? (array) $_REQUEST["checked"] : array();
    if ( isset( $_REQUEST["plugin"] ) ) { $checked[] = (string) $_REQUEST["plugin"]; }

    if ( in_array( $action, array( "delete-selected", "delete", "delete-plugin" ), true ) ) {
        $hit = wpc_locked_block( $checked );
        if ( $hit ) { wpc_locked_die( $hit, "删除" ); }
    }

    // 系统组件一律禁止启用/停用：停用 sqlite 会触发删除 db.php。
    if ( in_array( $action, array( "activate", "deactivate", "activate-selected", "deactivate-selected" ), true ) ) {
        foreach ( $checked as $p ) {
            if ( wpc_system_reason( $p ) ) { wpc_locked_die( $p, $action ); }
        }
    }
} );

