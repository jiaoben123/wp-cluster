PROTECT_PLUGIN_CONTENT='<?php
/**
 * Plugin Name: wp-cluster critical plugin guard
 * Description: 系统组件保护：隐藏 SQLite 数据库驱动，阻止误删 / 误激活会导致整站不可用的插件。
 * Version: 1.3.0
 */
if ( ! defined( "ABSPATH" ) ) { return; }

function wpc_locked_plugins() {
    return array(
