#!/usr/bin/env bash
# =============================================================================
#  wp-cluster — WordPress 站群管理工具
#  栈：OpenLiteSpeed + LSPHP + SQLite + APCu + LSCache (+ Cloudflare)
#  目标：单机批量部署互相独立的 WordPress 站点，磁盘/内存开销最小化
#  许可：MIT
# =============================================================================
#  设计要点
#  1. 状态注册表：每站一份 /etc/wp-cluster/sites/<domain>.env，工具只信它，
#     OLS 配置由工具生成；不再反向解析配置文件，避免格式漂移。
#  2. WP 核心硬链接共享：所有站点共用一份 wp-admin/wp-includes，新建站仅 +5MB。
#  3. 幂等：任何命令可重复执行；变更前自动备份配置，校验失败自动回滚。
#  4. 全局 flock：并发执行会排队，不会写坏配置。
#  5. 变更类命令支持 --dry-run，先看计划再落地。
# =============================================================================
set -Eeuo pipefail

WP_CLUSTER_MAIN=1
WP_CLUSTER_VERSION="2.3.4"

# ---------- 退出码（供监控/脚本判断）----------
readonly E_OK=0
readonly E_FAIL=1        # 一般失败
readonly E_USAGE=2       # 参数错误
readonly E_PRECOND=3     # 前置条件不满足（未 init、缺依赖）
readonly E_EXISTS=4      # 已存在
readonly E_NOENT=5       # 不存在
readonly E_LOCK=6        # 锁冲突
readonly E_VALIDATE=7    # 配置校验失败
readonly E_EXTERNAL=8    # 外部命令失败

# =============================================================================
#  默认配置（可被 /etc/wp-cluster/wp-cluster.conf 覆盖）
# =============================================================================
WWW_ROOT="/var/www"
CORE_DIR="/var/www/wp-core"
DB_DIR="/var/www/db"
STATE_DIR="/etc/wp-cluster"
BACKUP_DIR="/var/backups/wp-cluster"
# SQLite 驱动保险副本：插件目录被删掉时 db.php 靠它继续连库（见 harden_db_dropin）
SQLITE_FALLBACK_DIR="/var/www/sqlite-db"
LOG_DIR="/var/log/wp-cluster"
LOCK_FILE="/var/lock/wp-cluster.lock"
LOCK_TIMEOUT=1800

LSWS_HOME="/usr/local/lsws"
LSWS_CONF="$LSWS_HOME/conf/httpd_config.conf"
VHOST_DIR="$LSWS_HOME/conf/vhosts"
CERT_DIR="$LSWS_HOME/conf/cert"
PHP_BIN="/usr/local/lsws/lsphp83/bin/php"
WP_CLI="/usr/local/bin/wp"

WEB_USER="nobody"
WEB_GROUP="nogroup"
TEMPLATE_SITE=""                 # 留空则自动探测
PORT_START=8100
PORT_END=8199
DEFAULT_PHP_MEMORY="128M"
HARDLINK_PLUGINS=true
# 建站时跳过模板里这些 mu-plugin（逗号分隔，只写文件名）。
# 典型场景：模板站带了一个「无条件 noindex」的 force-noindex.php，
# 它会让 wp-cluster 的收录开关失效（enable 之后依然 noindex），必须拦在建站阶段。
TEMPLATE_STRIP_MU="force-noindex.php"

BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_MONTHLY_KEEP=6

# 故障隔离
POOL_CHILDREN_DEFAULT=3          # isolate --php-pool 未指定时的 PHP 子进程数
GUARD_INTERVAL="5min"            # guard 巡检间隔
GUARD_FAIL_THRESHOLD=3           # 连续失败几次记为 CRITICAL

# CF 优选 IP（cf probe 的候选目标，逗号分隔）
CF_PROBE_TARGETS="cf.090227.xyz,cf-cname.xingpingcn.top,cf.877774.xyz,cloudflare.182682.xyz,icook.hk,time.is"
CF_PROBE_ROUNDS=3

# 自更新地址解析顺序：环境变量 > 配置文件 SELF_UPDATE_URL > 更新标记文件 > 内置默认
# 标记文件由一行安装命令写入（/home/.wp-cluster-update-url），换仓库/换分支无需改代码
UPDATE_URL_DEFAULT="https://raw.githubusercontent.com/jiaoben123/wp-cluster/main/wp-cluster"
UPDATE_URL_MARKERS=("/etc/wp-cluster/update-url" "/home/.wp-cluster-update-url" "$HOME/.wp-cluster-update-url")
SELF_UPDATE_URL="${WP_CLUSTER_UPDATE_URL:-}"

# 运行态
DRY_RUN=false
JSON=false
ASSUME_YES=false
QUIET=false
VERBOSE=false
NO_COLOR="${NO_COLOR:-}"
CONFIG_FILE="${WP_CLUSTER_CONFIG:-/etc/wp-cluster/wp-cluster.conf}"
LOG_FILE=""
LOCK_FD=""

# =============================================================================
#  输出 / 日志
# =============================================================================
if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
  C_R=$'\033[0;31m'; C_G=$'\033[0;32m'; C_Y=$'\033[1;33m'
  C_B=$'\033[0;34m'; C_D=$'\033[0;36m'; C_0=$'\033[0m'; C_BD=$'\033[1m'
else
  C_R=''; C_G=''; C_Y=''; C_B=''; C_D=''; C_0=''; C_BD=''
fi

_log_line() {
  [ -n "$LOG_FILE" ] || return 0
  [ -d "$LOG_DIR" ] && [ -w "$LOG_DIR" ] || return 0
  printf '%s [%s] %s\n' "$(date '+%F %T')" "$1" "$2" >>"$LOG_FILE" 2>/dev/null || true
}
info()  { $QUIET || printf '%s[+]%s %s\n' "$C_G" "$C_0" "$*"; _log_line INFO "$*"; return 0; }
warn()  { printf '%s[!]%s %s\n' "$C_Y" "$C_0" "$*" >&2; _log_line WARN "$*"; return 0; }
err()   { printf '%s[x]%s %s\n' "$C_R" "$C_0" "$*" >&2; _log_line ERROR "$*"; return 0; }
debug() { $VERBOSE || return 0; printf '%s[·]%s %s\n' "$C_D" "$C_0" "$*" >&2; _log_line DEBUG "$*"; return 0; }
step()  { $QUIET || printf '%s→%s %s\n' "$C_B" "$C_0" "$*"; _log_line STEP "$*"; return 0; }

die()      { err "$*"; exit "$E_FAIL"; }
die_code() { local c=$1; shift; err "$*"; exit "$c"; }

on_err() {
  local code=$1 line=$2 cmd=$3
  if [ "$code" -eq 0 ]; then code=$E_FAIL; fi
  err "执行失败（退出码 $code，第 $line 行）：$cmd"
  _log_line ERROR "code=$code line=$line cmd=$cmd"
  exit "$code"
}
trap 'on_err $? $LINENO "$BASH_COMMAND"' ERR

# 建站失败时清理半成品（仅在 add 流程中生效，成功写入注册表后置空）
ADD_ROLLBACK=""
ADD_DB=""
ADD_VH=""
ADD_CONF_BAK=""
on_exit_cleanup() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ -n "${ADD_ROLLBACK:-}" ]; then
    if [ "${WP_CLUSTER_NO_ROLLBACK:-0}" = "1" ]; then
      err "建站中断，已按 WP_CLUSTER_NO_ROLLBACK=1 保留现场：$ADD_ROLLBACK"
      exit "$rc"
    fi
    err "建站中断，清理半成品（OLS 配置已回滚，注册表未写入）"
    rm -rf "$ADD_ROLLBACK" 2>/dev/null || true
    if [ -n "${ADD_DB:-}" ]; then rm -f "$ADD_DB" 2>/dev/null || true; fi
    if [ -n "${ADD_VH:-}" ]; then rm -rf "$ADD_VH" 2>/dev/null || true; fi
    if [ -n "${ADD_CONF_BAK:-}" ] && [ -f "$ADD_CONF_BAK" ]; then
      cp -a "$ADD_CONF_BAK" "$LSWS_CONF" 2>/dev/null || true
      rm -f "$ADD_CONF_BAK" 2>/dev/null || true
      systemctl restart lsws >/dev/null 2>&1 || true
    fi
  fi
  exit "$rc"
}
trap 'on_exit_cleanup' EXIT

# =============================================================================
#  基础工具
# =============================================================================
run() {
  if $DRY_RUN; then printf '%s[dry-run]%s %s\n' "$C_D" "$C_0" "$*"; return 0; fi
  debug "run: $*"
  "$@"
}

# 从 stdin 读内容写文件（支持 dry-run）
write_file() {
  local path=$1 content
  content=$(cat)
  if $DRY_RUN; then
    printf '%s[dry-run]%s 写入 %s (%s 字节)\n' "$C_D" "$C_0" "$path" "${#content}"
    return 0
  fi
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$content" >"$path"
  debug "write: $path"
}

need_root() {
  [ "${EUID:-$(id -u)}" -eq 0 ] || die_code "$E_PRECOND" "需要 root 权限运行（sudo wp-cluster $*）"
}

have() { command -v "$1" >/dev/null 2>&1; }

rand_hex() { openssl rand -hex 32; }

rand_pass() { openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 18; }

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

validate_domain() {
  local d=${1,,}
  case "$d" in
    ""|*[!a-z0-9.-]*) return 1 ;;
    .*|*.|*..*) return 1 ;;
  esac
  [[ "$d" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,24}$ ]] || return 1
  return 0
}

slugify() { printf '%s' "${1//[.-]/_}"; }

validate_port() {
  local p=$1
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  [ "$p" -ge 1024 ] && [ "$p" -le 65535 ] || return 1
  return 0
}

port_in_use() {
  local p=$1
  grep -qE "address[[:space:]]+\*:$p\b" "$LSWS_CONF" 2>/dev/null && return 0
  ss -tlnH 2>/dev/null | awk -v p=":$p" '$4 ~ p"$" {found=1} END {exit !found}' && return 0
  return 1
}

next_free_port() {
  local p=$PORT_START
  while [ "$p" -le "$PORT_END" ]; do
    if ! port_in_use "$p"; then printf '%s' "$p"; return 0; fi
    p=$((p + 1))
  done
  die_code "$E_FAIL" "端口区间 $PORT_START-$PORT_END 已用尽，请调整配置"
}

get_public_ip() {
  local ip=""
  ip=$(curl -4 -s --max-time 6 https://api.ipify.org 2>/dev/null || true)
  [ -z "$ip" ] && ip=$(curl -4 -s --max-time 6 https://ifconfig.me 2>/dev/null || true)
  [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  printf '%s' "${ip:-127.0.0.1}"
}

shq() { printf '%s' "${1//\"/\\\"}"; }

site_disk_kb() {
  find "$1" -type f -printf '%n %b\n' 2>/dev/null \
    | awk '{tot += $2; if ($1 > 1) sh += $2} END {printf "%d", (tot - sh) * 512 / 1024}'
}

human_size() {
  local kb=${1:-0}
  if   [ "$kb" -ge 1048576 ]; then awk -v k="$kb" 'BEGIN{printf "%.1fG", k/1048576}'
  elif [ "$kb" -ge 1024 ];    then awk -v k="$kb" 'BEGIN{printf "%.1fM", k/1024}'
  else printf '%sK' "$kb"; fi
}

fmt_sec() { awk -v t="${1:-0}" 'BEGIN{printf "%.3f", t+0}'; }

http_code() {
  local url=$1 timeout=${2:-12} code=""
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time "$timeout" "$url" 2>/dev/null) || true
  [ -n "$code" ] || code="000"
  printf '%s' "$code"
}

confirm() {
  if $ASSUME_YES; then return 0; fi
  [ -t 0 ] || die_code "$E_USAGE" "非交互环境请追加 --yes"
  local ans
  read -r -p "$1 (yes/no): " ans
  [ "$ans" = "yes" ]
}

confirm_typed() {
  if $ASSUME_YES; then return 0; fi
  [ -t 0 ] || die_code "$E_USAGE" "非交互环境请追加 --yes"
  local ans
  read -r -p "$1 请输入 \"$2\" 确认: " ans
  [ "$ans" = "$2" ]
}

tcp_wait() {
  local port=$1 timeout=${2:-25} i=0
  while [ "$i" -lt "$timeout" ]; do
    ss -tlnH 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" {f=1} END {exit !f}' && return 0
    sleep 1; i=$((i + 1))
  done
  return 1
}

# =============================================================================
#  配置加载
# =============================================================================
load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
    debug "已加载配置: $CONFIG_FILE"
  fi
  LOG_FILE="$LOG_DIR/wp-cluster.log"
}

# =============================================================================
#  锁
# =============================================================================
acquire_lock() {
  if $DRY_RUN; then return 0; fi
  mkdir -p "$(dirname "$LOCK_FILE")"
  exec {LOCK_FD}>"$LOCK_FILE" || die_code "$E_LOCK" "无法打开锁文件 $LOCK_FILE"
  if ! flock -w "$LOCK_TIMEOUT" "$LOCK_FD"; then
    die_code "$E_LOCK" "另一个 wp-cluster 进程正持有锁（等待 ${LOCK_TIMEOUT}s 超时）"
  fi
  debug "已获取全局锁"
}

# =============================================================================
#  状态注册表
# =============================================================================
meta_file() { printf '%s/sites/%s.env' "$STATE_DIR" "$1"; }
site_exists() { [ -f "$(meta_file "$1")" ]; }
require_site() { site_exists "$1" || die_code "$E_NOENT" "站点不存在: $1（wp-cluster list 查看）"; }

site_get() {
  # 用行解析而非 source：值里含空格/特殊字符也不会出错，且兼容历史未加引号的文件
  local f line key=$2
  f=$(meta_file "$1")
  [ -f "$f" ] || return 1
  [[ "$key" =~ ^[A-Z_]+$ ]] || return 1
  line=$(grep -m1 "^${key}=" "$f" 2>/dev/null) || return 1
  [ -n "$line" ] || return 1
  line=${line#*=}
  line=${line#\"}
  line=${line%\"}
  printf '%s' "$line"
}

site_set() {
  local domain=$1 key=$2 val=$3 f
  [[ "$key" =~ ^[A-Z_]+$ ]] || die_code "$E_USAGE" "非法字段: $key"
  f=$(meta_file "$domain")
  site_exists "$domain" || die_code "$E_NOENT" "站点不存在: $domain"
  if $DRY_RUN; then step "[dry-run] 更新 $domain.$key=$val"; return 0; fi
  if grep -qE "^${key}=" "$f"; then
    python3 - "$f" "$key" "$val" <<'PY'
import sys
f, k, v = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(f, encoding='utf-8').read().splitlines()
out = [f'{k}="{v}"' if l.startswith(k + '=') else l for l in lines]
open(f, 'w', encoding='utf-8').write('\n'.join(out) + '\n')
PY
  else
    printf '%s="%s"\n' "$key" "$val" >>"$f"
  fi
}

all_sites() {
  local f
  [ -d "$STATE_DIR/sites" ] || return 0
  for f in "$STATE_DIR"/sites/*.env; do
    [ -e "$f" ] || continue
    basename "$f" .env
  done | sort
}

site_count() { all_sites | wc -l | tr -d ' '; }

# =============================================================================
#  OLS 配置操作（python 状态机，避免正则误伤）
# =============================================================================
ols_conf() {
  python3 - "$LSWS_CONF" "$@" <<'PY'
import re, sys

conf, action = sys.argv[1], sys.argv[2]
args = sys.argv[3:]
lines = open(conf, encoding='utf-8').read().splitlines()

BLOCK = re.compile(r'^(virtualHost|listener)\s+(\S+?)\s*\{')

def find_blocks():
    out, cur = [], None
    for i, l in enumerate(lines):
        m = BLOCK.match(l)
        if m and cur is None:
            cur = [m.group(1), m.group(2), i]
        elif cur is not None and l.strip() == '}':
            cur.append(i)
            out.append(tuple(cur))
            cur = None
    return out

def write_back(new):
    if new == lines:
        return 0
    open(conf, 'w', encoding='utf-8').write('\n'.join(new) + '\n')
    return 1

changed = 0
domain = args[0] if args else ''

if action == 'has':
    for kind, name, s, e in find_blocks():
        body = '\n'.join(lines[s:e + 1])
        if kind == 'virtualHost' and name == domain:
            sys.exit(0)
        if kind == 'listener' and re.search(r'^\s*map\s+' + re.escape(domain) + r'\s', body, re.M):
            sys.exit(0)
    sys.exit(1)

elif action == 'add_test':
    site_dir, vh, port = args[1], args[2], args[3]
    block = f"""
virtualHost {domain} {{
  vhRoot                  {site_dir}
  configFile              {vh}
  allowSymbolLink         1
  enableScript            1
  restrained              1
}}

listener L{port} {{
  address                 *:{port}
  secure                  0
  map                     {domain} *
}}
"""
    lines += block.rstrip('\n').splitlines()
    changed = 1

elif action == 'add_domain':
    site_dir, vh = args[1], args[2]
    if not any(k == 'virtualHost' and n == domain for k, n, s, e in find_blocks()):
        block = f"""
virtualHost {domain} {{
  vhRoot                  {site_dir}
  configFile              {vh}
  allowSymbolLink         1
  enableScript            1
  restrained              1
}}
"""
        lines += block.rstrip('\n').splitlines()
        changed = 1
    # 把 map 写进 80/443 共享 listener（取块内最后一条 map 之后，保持缩进）
    inserts = []
    for kind, name, s, e in find_blocks():
        if kind != 'listener':
            continue
        body = lines[s:e]
        if not any(re.match(r'\s*address\s+\*:(80|443)\s*$', b) for b in body):
            continue
        if any(re.match(r'\s*map\s+' + re.escape(domain) + r'\s', b) for b in body):
            continue
        idx, indent = None, '    '
        for j, b in enumerate(body):
            if re.match(r'\s*map\s+', b):
                idx, indent = j, b[:len(b) - len(b.lstrip())]
        if idx is None:
            for j, b in enumerate(body):
                if re.match(r'\s*secure\s+', b):
                    idx, indent = j, b[:len(b) - len(b.lstrip())]
        if idx is None:
            idx = 0
        inserts.append((s + idx + 1, indent))
    for pos, indent in sorted(inserts, reverse=True):
        lines.insert(pos, f'{indent}map                     {domain} *')
        changed = 1

elif action == 'remove':
    drop = set()
    for kind, name, s, e in find_blocks():
        body = '\n'.join(lines[s:e + 1])
        if kind == 'virtualHost' and name == domain:
            drop.update(range(s, e + 1))
        elif kind == 'listener' and re.search(r'^\s*map\s+' + re.escape(domain) + r'\s', body, re.M):
            drop.update(range(s, e + 1))
    new = [l for i, l in enumerate(lines) if i not in drop]
    # 再清理共享 listener 里的 map 行
    new = [l for l in new if not re.match(r'\s*map\s+' + re.escape(domain) + r'\s+\*\s*$', l)]
    lines = new
    changed = 1

elif action == 'list':
    for kind, name, s, e in find_blocks():
        if kind != 'listener':
            continue
        body = lines[s:e + 1]
        port = ''
        for b in body:
            m = re.match(r'\s*address\s+\*:(\d+)', b)
            if m:
                port = m.group(1)
        maps = [m.group(1) for b in body if (m := re.match(r'\s*map\s+(\S+)\s', b))]
        for d in maps:
            print(f'{d}\t{port}')
    sys.exit(0)

else:
    sys.exit(1)

if changed:
    open(conf, 'w', encoding='utf-8').write(chr(10).join(lines) + chr(10))
sys.exit(0)
PY
}

ols_validate() {
  local rc=0 out
  out=$("$LSWS_HOME/bin/lshttpd" -t 2>&1) || rc=$?
  if printf '%s' "$out" | grep -qiE '\[(error|fatal)\]|syntax error|failed to start'; then
    printf '%s\n' "$out" | grep -iE 'error|fatal|syntax|failed' | head -5 >&2
    return 1
  fi
  return 0
}

# 变更 OLS 配置的原子封装：备份 → 执行 → 校验 → 失败回滚
ols_txn() {
  local desc=$1; shift
  # dry-run 绝不能碰真实配置：ols_conf 会直接写文件，必须在这里拦住
  if $DRY_RUN; then
    step "[dry-run] $desc（不修改 OLS 配置）"
    return 0
  fi
  local bak="$LSWS_CONF.bak.$(date +%Y%m%d%H%M%S).$$"
  cp -a "$LSWS_CONF" "$bak"
  if ! "$@"; then
    err "$desc 失败"
    cp -a "$bak" "$LSWS_CONF"; rm -f "$bak"
    return 1
  fi
  if ! ols_validate; then
    err "$desc 后配置校验不通过，已回滚"
    cp -a "$bak" "$LSWS_CONF"; rm -f "$bak"
    return 1
  fi
  rm -f "$bak"
  return 0
}

ols_restart() {
  if $DRY_RUN; then step "[dry-run] systemctl restart lsws"; return 0; fi
  step "重启 OpenLiteSpeed（listener 变更需完整重启）"
  systemctl restart lsws || die_code "$E_EXTERNAL" "OLS 重启失败，请检查 journalctl -u lsws"
  tcp_wait 80 30 || warn "80 端口未在 30s 内监听"
  systemctl is-active --quiet lsws || die_code "$E_EXTERNAL" "OLS 未处于 active 状态"
  sleep 1
}

# =============================================================================
#  WordPress 封装
# =============================================================================
wp_run() {
  local path=$1; shift
  "$PHP_BIN" "$WP_CLI" --path="$path" --allow-root "$@"
}

fix_owner_after_wp() {
  local dir=$1 db
  $DRY_RUN && return 0
  db=$(awk -F"'" '/DB_PATH/{print $4; exit}' "$dir/wp-config.php" 2>/dev/null || true)
  if [ -n "${db:-}" ]; then
    find "$(dirname "$db")" -maxdepth 1 -name "$(basename "$db")*" -exec chown "$WEB_USER:$WEB_GROUP" {} + 2>/dev/null || true
    [ -f "$db" ] && chmod 664 "$db" 2>/dev/null || true
  fi
  find "$dir" -maxdepth 1 \( -name '*.php' -o -name '.htaccess' \) -exec chown "$WEB_USER:$WEB_GROUP" {} + 2>/dev/null || true
  return 0
}

wp_quiet() {
  local path=$1; shift
  if $DRY_RUN; then printf '%s[dry-run]%s wp %s\n' "$C_D" "$C_0" "$*"; return 0; fi
  if "$PHP_BIN" "$WP_CLI" --path="$path" --allow-root "$@" >>"$LOG_DIR/wp-cli.log" 2>&1; then
    fix_owner_after_wp "$path"
    return 0
  fi
  fix_owner_after_wp "$path"
  return 1
}

ensure_ownership() {
  local dir=$1 db=${2:-}
  if $DRY_RUN; then return 0; fi
  chown -R "$WEB_USER:$WEB_GROUP" "$dir" 2>/dev/null || true
  find "$dir" -type d -exec chmod 755 {} + 2>/dev/null || true
  find "$dir" -type f -exec chmod 644 {} + 2>/dev/null || true
  [ -n "$db" ] && [ -f "$db" ] && chmod 664 "$db" 2>/dev/null || true
  [ -n "$db" ] && chown "$WEB_USER:$WEB_GROUP" "$(dirname "$db")" 2>/dev/null || true
  return 0
}

# =============================================================================
#  共享核心
# =============================================================================
detect_template() {
  if [ -n "${TEMPLATE_SITE:-}" ] && [ -d "$TEMPLATE_SITE/wp-content/plugins/sqlite-database-integration" ]; then
    return 0
  fi
  # 选“内容最丰富”的站点做模板：插件数优先，其次主题数、媒体文件
  local d best="" best_score=-1 pc tc uc score
  for d in "$WWW_ROOT"/*/; do
    d=${d%/}
    [ -d "$d/wp-content/plugins/sqlite-database-integration" ] || continue
    [ -f "$d/wp-content/db.php" ] || continue
    pc=$(find "$d/wp-content/plugins" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    tc=$(find "$d/wp-content/themes" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    mc=$(find "$d/wp-content/mu-plugins" -maxdepth 1 -name '*.php' 2>/dev/null | wc -l)
    uc=0
    if [ -n "$(find "$d/wp-content/uploads" -type f -print -quit 2>/dev/null)" ]; then uc=1; fi
    score=$((mc * 100 + pc * 10 + tc + uc))
    if [ "$score" -gt "$best_score" ]; then best_score=$score; best=$d; fi
  done
  if [ -n "$best" ]; then
    TEMPLATE_SITE=$best
    debug "自动探测模板站: $TEMPLATE_SITE（评分 $best_score）"
    return 0
  fi
  return 1
}

build_core() {
  local items=(wp-admin wp-includes index.php wp-activate.php wp-blog-header.php
    wp-comments-post.php wp-config-sample.php wp-cron.php wp-links-opml.php
    wp-load.php wp-login.php wp-mail.php wp-settings.php wp-signup.php
    wp-trackback.php xmlrpc.php license.txt readme.html)
  local it

  if [ -f "$CORE_DIR/wp-load.php" ]; then
    info "共享核心已存在，跳过构建（$CORE_DIR）"
    return 0
  fi
  step "构建共享核心目录（硬链接自 $TEMPLATE_SITE）"
  run mkdir -p "$CORE_DIR"
  for it in "${items[@]}"; do
    [ -e "$TEMPLATE_SITE/$it" ] || continue
    if $DRY_RUN; then continue; fi
    cp -a --link "$TEMPLATE_SITE/$it" "$CORE_DIR/" 2>/dev/null || cp -a "$TEMPLATE_SITE/$it" "$CORE_DIR/"
  done
  chmod 755 "$CORE_DIR"
  info "核心就绪：$(du -sh "$CORE_DIR" 2>/dev/null | awk '{print $1}')（全站共享一份）"
}

