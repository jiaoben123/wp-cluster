// 系统组件：通过 drop-in 工作，不依赖 active_plugins。
// 关键：SQLite 插件的停用回调会 $wp_filesystem->delete( WP_CONTENT_DIR . "/db.php" )，
// 所以绝不能让它被「启用」——一旦以后停用，就会删掉真正的数据库驱动。
function wpc_system_plugins() {
    return array(
        "sqlite-database-integration" => "SQLite 数据库驱动（系统组件，保持未启用是正确状态）"
    );
}

function wpc_plugin_dir( $plugin ) {
    return strtok( (string) $plugin, "/" );
}

function wpc_locked_reason( $plugin ) {
    $locked = wpc_locked_plugins();
    $dir    = wpc_plugin_dir( $plugin );
    return isset( $locked[ $dir ] ) ? $locked[ $dir ] : "";
}

function wpc_system_reason( $plugin ) {
    $system = wpc_system_plugins();
    $dir    = wpc_plugin_dir( $plugin );
    return isset( $system[ $dir ] ) ? $system[ $dir ] : "";
}

function wpc_locked_block( $plugins ) {
    foreach ( (array) $plugins as $p ) {
        if ( wpc_locked_reason( $p ) ) { return $p; }
    }
    return "";
}

function wpc_locked_die( $plugin, $action = "删除" ) {
    wp_die(
        "<h1>这个组件受保护，不能" . esc_html( $action ) . "</h1>"
        . "<p>插件：<code>" . esc_html( $plugin ) . "</code></p>"
        . "<p>" . esc_html( wpc_locked_reason( $plugin ) ) . "</p>"
        . "<p>确实需要操作，请先在服务器上把 <code>wp-content/mu-plugins/zz-wpc-protect-critical.php</code> 改名停用保护，再回来操作。</p>",
        "组件受保护",
        array( "response" => 403, "back_link" => true )
    );
}

// 0) 系统组件隐藏：SQLite 驱动不出现在「已安装插件」列表。
//    客户看不到，自然不会去点启用 / 删除；drop-in 仍然照常加载，不受影响。
add_filter( "all_plugins", function ( $plugins ) {
    foreach ( array_keys( (array) $plugins ) as $file ) {
        if ( wpc_system_reason( $file ) ) { unset( $plugins[ $file ] ); }
    }
    return $plugins;
}, 999 );

// 1) 界面层：对其余受保护插件去掉「删除」链接，并加一个受保护标记
add_filter( "plugin_action_links", function ( $actions, $plugin_file = "" ) {
    if ( ! wpc_locked_reason( $plugin_file ) ) { return $actions; }
    unset( $actions["delete"] );
